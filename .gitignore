# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# Build output from `uv build`
/build/
/dist/
*.vsix

# Secrets / environment
.env
.env.*

# Environments
.venv/
venv/

# uv
uv.lock

# semi-git runtime data (only present if `sgt init` is run inside this repo)
.sgt/

# Written by `sgt init --agent`, and machine-specific: each file names the absolute path of the
# `sgt` that generated it, so a committed copy would be wrong for everyone else. The skills are
# generated too -- their source of truth is sgt/agent_assets/skills/, which ships in the wheel.
# Run `sgt init --agent` after cloning to get your own copies.
/.mcp.json
/.vscode/settings.json
/.claude/settings.json
/.claude/skills/sgt-agent/
/.claude/skills/sgt-plan/
/.claude/skills/sgt-workflow/


# Vendored reference checkouts, at the root only. Anchored deliberately: an unanchored
# `references/` also matched `.claude/skills/*/references/`, which is the standard place a skill
# keeps its progressively-loaded docs -- so a skill's own references were silently untracked and
# would vanish for anyone cloning.
/references/

papers/
.DS_Store
review/
# study/
allinone.md
# docs/plans/
docs/design/
docs/brainstorms/
docs/ideation/
docs/slides/

.hypothesis
# Study website build output. Source is web/src; node_modules and dist are not.
web/node_modules/
web/dist/
web/.firebase/
web/*.tsbuildinfo

# Participant bundles are built, not committed. scripts/study-bundle/ is the
# template and IS committed; these are the per-run artefacts it produces.
scripts/study-bundle/telemetry/events.jsonl
scripts/study-bundle/telemetry/uploaded.txt
scripts/study-bundle/telemetry/state.json

# Built participant bundles. They are generated into the site's static files by
# scripts/make-study-bundle.sh and published by `firebase deploy`; the sources
# they are built from are scripts/study-bundle/ and ~/repos/sgt-study.
web/public/bundles/

# Firebase CLI noise
firebase-debug.log
firestore-debug.log

# pdflatex run from the repo root instead of paper/ leaves this behind
texput.log

# LaTeX Workshop builds with -synctex=1; the .gz is derived and the "(busy)" file
# is a partial write from a build that was still running
paper/main.synctex.gz
paper/main.synctex(busy)
