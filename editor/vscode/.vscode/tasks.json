{
  // F5 builds first (launch.json's preLaunchTask), so the Extension Development Host never runs a
  // stale dist/extension.js. media/ is loaded from disk as is and needs no build.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "compile",
      "type": "npm",
      "script": "compile",
      "problemMatcher": "$tsc",
      "presentation": { "reveal": "silent" }
    }
  ]
}
