{
  "name": "ugh",
  "displayName": "ugh",
  "description": "Steps you can name, take out and bring back, beside your code.",
  "version": "0.6.10",
  "publisher": "ugh",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ryanyen2/ugh.git",
    "directory": "editor/vscode"
  },
  "homepage": "https://github.com/ryanyen2/ugh",
  "bugs": {
    "url": "https://github.com/ryanyen2/ugh/issues"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "SCM Providers",
    "Visualization"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:.sgt/local/ideal.json"
  ],
  "contributes": {
    "configuration": {
      "title": "ugh",
      "properties": {
        "ugh.path": {
          "type": "string",
          "default": "ugh",
          "markdownDescription": "The `ugh` executable. `ugh init --agent` sets it."
        },
        "ugh.blame.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Tint each named definition at its left edge in its name's hue."
        },
        "ugh.inlayHints.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Show a definition's name at the end of its first line."
        },
        "ugh.render.devCommand": {
          "type": "string",
          "default": "npx vite --host 127.0.0.1 --port ${port} --strictPort",
          "markdownDescription": "The command that serves the running app's tree. `${port}` becomes a free port."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ugh",
          "title": "ugh",
          "icon": "media/ugh-icon.svg"
        }
      ],
      "panel": [
        {
          "id": "ughWorkbenchPanel",
          "title": "ugh",
          "icon": "media/ugh-icon.svg"
        }
      ]
    },
    "views": {
      "ugh": [
        {
          "id": "ughStatus",
          "name": "Status"
        },
        {
          "id": "ughNames",
          "name": "Names"
        }
      ],
      "ughWorkbenchPanel": [
        {
          "type": "webview",
          "id": "ughWorkbench",
          "name": "Workbench"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "ughStatus",
        "contents": "This folder has no ugh record.\n[Initialize](command:ugh.init)",
        "when": "!ugh.hasRoot"
      }
    ],
    "commands": [
      {
        "command": "ugh.openWorkbench",
        "title": "Open workbench",
        "category": "ugh",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "ugh.revealInWorkbench",
        "title": "Reveal in workbench",
        "category": "ugh",
        "icon": "$(target)"
      },
      {
        "command": "ugh.refresh",
        "title": "Refresh",
        "category": "ugh",
        "icon": "$(refresh)"
      },
      {
        "command": "ugh.save",
        "title": "Save",
        "category": "ugh"
      },
      {
        "command": "ugh.undo",
        "title": "Undo",
        "category": "ugh"
      },
      {
        "command": "ugh.sync",
        "title": "Sync",
        "category": "ugh"
      },
      {
        "command": "ugh.push",
        "title": "Push",
        "category": "ugh"
      },
      {
        "command": "ugh.init",
        "title": "Initialize",
        "category": "ugh"
      },
      {
        "command": "ugh.takeOut",
        "title": "Take out…",
        "category": "ugh",
        "icon": "$(remove)"
      },
      {
        "command": "ugh.bringBack",
        "title": "Bring back…",
        "category": "ugh",
        "icon": "$(add)"
      },
      {
        "command": "ugh.takeOutDefinition",
        "title": "Take out definition",
        "category": "ugh"
      },
      {
        "command": "ugh.name",
        "title": "Name…",
        "category": "ugh"
      },
      {
        "command": "ugh.nameDefinition",
        "title": "Name definition",
        "category": "ugh"
      },
      {
        "command": "ugh.rename",
        "title": "Rename…",
        "category": "ugh",
        "icon": "$(edit)"
      },
      {
        "command": "ugh.resolve",
        "title": "Resolve…",
        "category": "ugh"
      },
      {
        "command": "ugh.resolveTheirs",
        "title": "Take theirs",
        "category": "ugh"
      },
      {
        "command": "ugh.resolveOurs",
        "title": "Keep ours",
        "category": "ugh"
      },
      {
        "command": "ugh.resolveApply",
        "title": "Use file as edited",
        "category": "ugh"
      },
      {
        "command": "ugh.toggleBlame",
        "title": "Toggle blame",
        "category": "ugh"
      },
      {
        "command": "ugh.openRenderPanel",
        "title": "Open running app",
        "category": "ugh"
      },
      {
        "command": "ugh.openUnsaved",
        "title": "Open diff against HEAD",
        "category": "ugh"
      },
      {
        "command": "ugh.openStep",
        "title": "Open step",
        "category": "ugh"
      },
      {
        "command": "ugh.jumpToLocation",
        "title": "Jump to location",
        "category": "ugh"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "ugh.resolveTheirs",
          "when": "false"
        },
        {
          "command": "ugh.resolveOurs",
          "when": "false"
        },
        {
          "command": "ugh.resolveApply",
          "when": "false"
        },
        {
          "command": "ugh.openUnsaved",
          "when": "false"
        },
        {
          "command": "ugh.openStep",
          "when": "false"
        },
        {
          "command": "ugh.jumpToLocation",
          "when": "false"
        },
        {
          "command": "ugh.revealInWorkbench",
          "when": "ugh.hasRoot"
        },
        {
          "command": "ugh.refresh",
          "when": "ugh.hasRoot"
        },
        {
          "command": "ugh.save",
          "when": "ugh.hasRoot"
        },
        {
          "command": "ugh.undo",
          "when": "ugh.hasRoot"
        },
        {
          "command": "ugh.sync",
          "when": "ugh.hasRoot"
        },
        {
          "command": "ugh.push",
          "when": "ugh.hasRoot"
        },
        {
          "command": "ugh.takeOut",
          "when": "ugh.hasRoot"
        },
        {
          "command": "ugh.bringBack",
          "when": "ugh.hasRoot"
        },
        {
          "command": "ugh.takeOutDefinition",
          "when": "ugh.hasRoot"
        },
        {
          "command": "ugh.name",
          "when": "ugh.hasRoot"
        },
        {
          "command": "ugh.nameDefinition",
          "when": "ugh.hasRoot"
        },
        {
          "command": "ugh.rename",
          "when": "ugh.hasRoot"
        },
        {
          "command": "ugh.resolve",
          "when": "ugh.hasRoot"
        },
        {
          "command": "ugh.toggleBlame",
          "when": "ugh.hasRoot"
        },
        {
          "command": "ugh.openRenderPanel",
          "when": "ugh.hasRoot"
        }
      ],
      "view/title": [
        {
          "command": "ugh.refresh",
          "when": "view == ughStatus",
          "group": "navigation"
        },
        {
          "command": "ugh.openWorkbench",
          "when": "view == ughNames",
          "group": "navigation"
        },
        {
          "command": "ugh.refresh",
          "when": "view == ughNames",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "ugh.revealInWorkbench",
          "when": "view == ughNames && viewItem =~ /^ughName/",
          "group": "inline@1"
        },
        {
          "command": "ugh.takeOut",
          "when": "view == ughNames && viewItem =~ /^ughName.*\\.in/",
          "group": "inline@2"
        },
        {
          "command": "ugh.bringBack",
          "when": "view == ughNames && viewItem =~ /^ughName.*\\.out/",
          "group": "inline@2"
        },
        {
          "command": "ugh.rename",
          "when": "view == ughNames && viewItem =~ /^ughName/",
          "group": "inline@3"
        },
        {
          "command": "ugh.revealInWorkbench",
          "when": "view == ughNames && viewItem =~ /^ughName/",
          "group": "1@1"
        },
        {
          "command": "ugh.takeOut",
          "when": "view == ughNames && viewItem =~ /^ughName.*\\.in/",
          "group": "1@2"
        },
        {
          "command": "ugh.bringBack",
          "when": "view == ughNames && viewItem =~ /^ughName.*\\.out/",
          "group": "1@3"
        },
        {
          "command": "ugh.rename",
          "when": "view == ughNames && viewItem =~ /^ughName/",
          "group": "1@4"
        },
        {
          "command": "ugh.resolveTheirs",
          "when": "view == ughStatus && viewItem == ughChoice",
          "group": "1@1"
        },
        {
          "command": "ugh.resolveOurs",
          "when": "view == ughStatus && viewItem == ughChoice",
          "group": "1@2"
        },
        {
          "command": "ugh.resolveApply",
          "when": "view == ughStatus && viewItem == ughChoice",
          "group": "1@3"
        }
      ],
      "editor/context": [
        {
          "command": "ugh.takeOutDefinition",
          "when": "ugh.hasRoot && resourceScheme == file",
          "group": "ugh@1"
        },
        {
          "command": "ugh.nameDefinition",
          "when": "ugh.hasRoot && resourceScheme == file",
          "group": "ugh@2"
        },
        {
          "command": "ugh.revealInWorkbench",
          "when": "ugh.hasRoot && resourceScheme == file",
          "group": "ugh@3"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc --noEmit && node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "tsc --noEmit && node esbuild.js --production",
    "vscode:prepublish": "npm run package",
    "test": "node --test src/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.21.0",
    "typescript": "^5.4.0"
  }
}
