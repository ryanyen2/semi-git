{
  "name": "semi-git",
  "displayName": "semi-git (sgt)",
  "description": "Read your code by feature, not by diff — semantic blame, a feature DAG, and one-click plug-in/plug-out, in-situ.",
  "version": "0.1.0",
  "publisher": "semi-git",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "SCM Providers",
    "Visualization"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:**/.sgt/local/ideal.json"
  ],
  "contributes": {
    "configuration": {
      "title": "semi-git",
      "properties": {
        "sgt.path": {
          "type": "string",
          "default": "sgt",
          "description": "Path to the `sgt` executable. Defaults to `sgt` on your PATH."
        },
        "sgt.blame.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Tint whole files by the feature that owns each span (gutter + overview ruler)."
        }
      }
    },
    "commands": [
      { "command": "sgt.refresh", "title": "Refresh", "category": "semi-git", "icon": "$(refresh)" },
      { "command": "sgt.toggleBlame", "title": "Toggle Feature Blame", "category": "semi-git" },
      { "command": "sgt.previewRevert", "title": "Preview Revert Feature (plug out)", "category": "semi-git", "icon": "$(diff)" },
      { "command": "sgt.revert", "title": "Revert Feature (plug out)", "category": "semi-git" }
    ],
    "viewsContainers": {
      "activitybar": [
        { "id": "sgt", "title": "semi-git", "icon": "media/sgt.svg" }
      ]
    },
    "views": {
      "sgt": [
        { "id": "sgtGraph", "name": "Feature Map" }
      ]
    },
    "menus": {
      "view/title": [
        { "command": "sgt.refresh", "when": "view == sgtGraph", "group": "navigation" }
      ],
      "view/item/context": [
        { "command": "sgt.previewRevert", "when": "view == sgtGraph && viewItem == sgtFeature", "group": "1_preview" },
        { "command": "sgt.revert", "when": "view == sgtGraph && viewItem == sgtFeature", "group": "2_apply" }
      ]
    }
  },
  "scripts": {
    "compile": "tsc --noEmit && node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "tsc --noEmit && node esbuild.js --production",
    "vscode:prepublish": "npm run package"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.21.0",
    "typescript": "^5.4.0"
  }
}
