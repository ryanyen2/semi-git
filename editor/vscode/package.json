{
  "name": "ugh",
  "displayName": "ugh",
  "description": "See which feature owns each line of code, and remove or restore one feature's work without touching the rest.",
  "version": "0.6.10",
  "publisher": "ugh",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ryanyen2/ugh.git",
    "directory": "editor/vscode"
  },
  "homepage": "https://github.com/ryanyen2/ugh",
  "bugs": {
    "url": "https://github.com/ryanyen2/ugh/issues"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "SCM Providers",
    "Visualization"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onCommand:ugh.init",
    "onCommand:ugh.openRenderPanel",
    "onCommand:ugh.openWorkbench",
    "onCommand:ugh.openLedger",
    "onView:ughFeatures",
    "workspaceContains:**/.sgt/local/ideal.json"
  ],
  "contributes": {
    "configuration": {
      "title": "ugh",
      "properties": {
        "ugh.path": {
          "type": "string",
          "default": "ugh",
          "description": "Path to the `ugh` executable. Defaults to `ugh` on your PATH."
        },
        "ugh.blame.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Tint whole files by the feature that owns each span (gutter + overview ruler)."
        },
        "ugh.plan.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show a CodeLens above lines matched or drifted from the active plan session."
        },
        "ugh.inlayHints.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Show a \u2039feature-label \u00b7N ops\u203a inlay hint at each symbol's definition line."
        },
        "ugh.diagnostics.drift": {
          "type": "boolean",
          "default": true,
          "description": "Show a Hint diagnostic (with a 'Save to clear' quick-fix) on drifted spans."
        },
        "ugh.diagnostics.forks": {
          "type": "boolean",
          "default": true,
          "description": "Show a Warning diagnostic on symbols with an open fork."
        },
        "ugh.render.devCommand": {
          "type": "string",
          "default": "npx vite --host 127.0.0.1 --port ${port} --strictPort",
          "markdownDescription": "Command the render panel runs to serve the folded tree. `${port}` is substituted with a free port. Runs in a scratch copy of the fold, never in your working tree."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ugh",
          "title": "ugh",
          "icon": "media/ugh-icon.svg"
        }
      ],
      "panel": [
        {
          "id": "ughWorkbenchPanel",
          "title": "ugh Workbench",
          "icon": "media/ugh-icon.svg"
        }
      ]
    },
    "views": {
      "ugh": [
        {
          "id": "ughNow",
          "name": "Now",
          "icon": "media/ugh-icon.svg",
          "when": "ugh.hasRoot"
        },
        {
          "id": "ughFeatures",
          "name": "Features",
          "icon": "media/ugh-icon.svg"
        },
        {
          "id": "ughChanges",
          "name": "Changes",
          "icon": "media/ugh-icon.svg",
          "when": "ugh.hasRoot"
        }
      ],
      "ughWorkbenchPanel": [
        {
          "type": "webview",
          "id": "ughWorkbench",
          "name": "Composition Workbench",
          "when": "ugh.hasRoot"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "ughFeatures",
        "contents": "No `.sgt` store found in this workspace.\n[Initialize ugh](command:ugh.init)\nReads your existing git history into the op store under `.sgt/`. Your git history and working tree are left untouched.",
        "when": "!ugh.hasRoot"
      }
    ],
    "commands": [
      {
        "command": "ugh.refresh",
        "title": "Refresh",
        "category": "ugh",
        "icon": "$(refresh)"
      },
      {
        "command": "ugh.runNextAction",
        "title": "Run Next Action",
        "category": "ugh"
      },
      {
        "command": "ugh.toggleBlame",
        "title": "Toggle Feature Blame",
        "category": "ugh"
      },
      {
        "command": "ugh.openWorkbench",
        "title": "Open Composition Workbench",
        "category": "ugh",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "ugh.openLedger",
        "title": "Open Ledger",
        "category": "ugh",
        "icon": "$(list-flat)"
      },
      {
        "command": "ugh.openRenderPanel",
        "title": "Open Running App (render panel)",
        "category": "ugh"
      },
      {
        "command": "ugh.revealInWorkbench",
        "title": "Reveal Feature in Workbench",
        "category": "ugh"
      },
      {
        "command": "ugh.previewRevert",
        "title": "Preview Revert (plug out)",
        "category": "ugh",
        "icon": "$(diff)"
      },
      {
        "command": "ugh.revert",
        "title": "Revert (choose which dependents to keep)",
        "category": "ugh"
      },
      {
        "command": "ugh.revertSymbol",
        "title": "Revert Symbol Under Cursor (choose dependents)",
        "category": "ugh"
      },
      {
        "command": "ugh.restore",
        "title": "Restore (plug in)",
        "category": "ugh"
      },
      {
        "command": "ugh.edit",
        "title": "Edit in place",
        "category": "ugh"
      },
      {
        "command": "ugh.showPlanQuickPick",
        "title": "Show Plan Steps",
        "category": "ugh"
      },
      {
        "command": "ugh.showPlanDiff",
        "title": "Show Plan Step Diff",
        "category": "ugh"
      },
      {
        "command": "ugh.init",
        "title": "Initialize (ugh init)",
        "category": "ugh"
      },
      {
        "command": "ugh.resolveFork",
        "title": "Resolve Fork",
        "category": "ugh"
      },
      {
        "command": "ugh.resolveStalledPlan",
        "title": "Resolve Stalled Plan",
        "category": "ugh"
      },
      {
        "command": "ugh.proposeLand",
        "title": "Land Proposal",
        "category": "ugh (advanced)"
      },
      {
        "command": "ugh.proposePublish",
        "title": "Publish Proposal (GitHub PR)",
        "category": "ugh (advanced)"
      },
      {
        "command": "ugh.viewProposal",
        "title": "View Proposal",
        "category": "ugh (advanced)"
      },
      {
        "command": "ugh.jumpToLocation",
        "title": "Jump to Location",
        "category": "ugh"
      },
      {
        "command": "ugh.switch",
        "title": "Switch Branch",
        "category": "ugh"
      },
      {
        "command": "ugh.save",
        "title": "Save",
        "category": "ugh"
      },
      {
        "command": "ugh.undo",
        "title": "Undo Last Operation",
        "category": "ugh"
      },
      {
        "command": "ugh.sync",
        "title": "Sync",
        "category": "ugh",
        "icon": "$(sync)"
      },
      {
        "command": "ugh.push",
        "title": "Push",
        "category": "ugh",
        "icon": "$(repo-push)"
      },
      {
        "command": "ugh.land",
        "title": "Land Branch",
        "category": "ugh"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "ugh.refresh",
          "when": "view == ughNow",
          "group": "navigation"
        },
        {
          "command": "ugh.refresh",
          "when": "view == ughFeatures",
          "group": "navigation"
        },
        {
          "command": "ugh.openLedger",
          "when": "view == ughFeatures",
          "group": "navigation"
        },
        {
          "command": "ugh.refresh",
          "when": "view == ughChanges",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "ugh.revertSymbol",
          "when": "ugh.hasRoot && editorTextFocus",
          "group": "ugh@1"
        },
        {
          "command": "ugh.revealInWorkbench",
          "when": "ugh.hasRoot && editorTextFocus",
          "group": "ugh@2"
        }
      ],
      "view/item/context": [
        {
          "command": "ugh.previewRevert",
          "when": "view == ughFeatures && viewItem == ughFeature"
        },
        {
          "command": "ugh.revert",
          "when": "view == ughFeatures && viewItem == ughFeature"
        },
        {
          "command": "ugh.restore",
          "when": "view == ughFeatures && viewItem == ughFeature"
        },
        {
          "command": "ugh.edit",
          "when": "view == ughFeatures && viewItem == ughFeature"
        },
        {
          "command": "ugh.previewRevert",
          "when": "view == ughFeatures && viewItem == ughChapter",
          "group": "ugh@1"
        },
        {
          "command": "ugh.revert",
          "when": "view == ughFeatures && viewItem == ughChapter",
          "group": "ugh@1"
        },
        {
          "command": "ugh.restore",
          "when": "view == ughFeatures && viewItem == ughChapter",
          "group": "ugh@1"
        }
      ]
    },
    "walkthroughs": [
      {
        "id": "ugh.gettingStarted",
        "title": "Get started with ugh",
        "description": "Set up ugh and see your codebase clustered by feature.",
        "steps": [
          {
            "id": "install",
            "title": "Install the ugh CLI",
            "description": "This extension shells out to the `ugh` CLI on your PATH.",
            "media": {
              "markdown": "walkthroughs/getting-started/install.md"
            },
            "completionEvents": [
              "onContext:ugh.hasRoot"
            ]
          },
          {
            "id": "init",
            "title": "Initialize this workspace",
            "description": "Read your git history into the op store under `.sgt/`.",
            "media": {
              "markdown": "walkthroughs/getting-started/init.md"
            },
            "completionEvents": [
              "onCommand:ugh.init"
            ]
          },
          {
            "id": "explore",
            "title": "Explore your feature tree",
            "description": "See your codebase clustered into features.",
            "media": {
              "markdown": "walkthroughs/getting-started/explore.md"
            },
            "completionEvents": [
              "onView:ughFeatures"
            ]
          }
        ]
      }
    ]
  },
  "scripts": {
    "compile": "tsc --noEmit && node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "tsc --noEmit && node esbuild.js --production",
    "vscode:prepublish": "npm run package",
    "test": "node --test src/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.21.0",
    "typescript": "^5.4.0"
  }
}
