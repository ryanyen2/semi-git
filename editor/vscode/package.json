{
  "name": "semi-git",
  "displayName": "semi-git (sgt)",
  "description": "See which feature owns each line of code, and remove or restore one feature's work without touching the rest.",
  "version": "0.6.10",
  "publisher": "semi-git",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ryanyen2/semi-git.git",
    "directory": "editor/vscode"
  },
  "homepage": "https://github.com/ryanyen2/semi-git",
  "bugs": {
    "url": "https://github.com/ryanyen2/semi-git/issues"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "SCM Providers",
    "Visualization"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onCommand:sgt.init",
    "onCommand:sgt.openRenderPanel",
    "onCommand:sgt.openWorkbench",
    "onView:sgtFeatures",
    "workspaceContains:**/.sgt/local/ideal.json"
  ],
  "contributes": {
    "configuration": {
      "title": "semi-git",
      "properties": {
        "sgt.path": {
          "type": "string",
          "default": "sgt",
          "description": "Path to the `sgt` executable. Defaults to `sgt` on your PATH."
        },
        "sgt.blame.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Tint whole files by the feature that owns each span (gutter + overview ruler)."
        },
        "sgt.plan.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show a CodeLens above lines matched or drifted from the active plan session."
        },
        "sgt.inlayHints.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Show a \u2039feature-label \u00b7N ops\u203a inlay hint at each symbol's definition line."
        },
        "sgt.diagnostics.drift": {
          "type": "boolean",
          "default": true,
          "description": "Show a Hint diagnostic (with a 'Save to clear' quick-fix) on drifted spans."
        },
        "sgt.diagnostics.forks": {
          "type": "boolean",
          "default": true,
          "description": "Show a Warning diagnostic on symbols with an open fork."
        },
        "sgt.render.devCommand": {
          "type": "string",
          "default": "npx vite --host 127.0.0.1 --port ${port} --strictPort",
          "markdownDescription": "Command the render panel runs to serve the folded tree. `${port}` is substituted with a free port. Runs in a scratch copy of the fold, never in your working tree."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "semi-git",
          "title": "semi-git",
          "icon": "media/sgt-icon.svg"
        }
      ],
      "panel": [
        {
          "id": "sgtWorkbenchPanel",
          "title": "SGT Workbench",
          "icon": "media/sgt-icon.svg"
        }
      ]
    },
    "views": {
      "semi-git": [
        {
          "id": "sgtNow",
          "name": "Now",
          "icon": "media/sgt-icon.svg",
          "when": "sgt.hasRoot"
        },
        {
          "id": "sgtFeatures",
          "name": "Features",
          "icon": "media/sgt-icon.svg"
        },
        {
          "id": "sgtChanges",
          "name": "Changes",
          "icon": "media/sgt-icon.svg",
          "when": "sgt.hasRoot"
        }
      ],
      "sgtWorkbenchPanel": [
        {
          "type": "webview",
          "id": "sgtWorkbench",
          "name": "Composition Workbench",
          "when": "sgt.hasRoot"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "sgtFeatures",
        "contents": "No `.sgt` store found in this workspace.\n[Initialize semi-git](command:sgt.init)\nReads your existing git history into the op store under `.sgt/`. Your git history and working tree are left untouched.",
        "when": "!sgt.hasRoot"
      }
    ],
    "commands": [
      {
        "command": "sgt.refresh",
        "title": "Refresh",
        "category": "semi-git",
        "icon": "$(refresh)"
      },
      {
        "command": "sgt.runNextAction",
        "title": "Run Next Action",
        "category": "semi-git"
      },
      {
        "command": "sgt.toggleBlame",
        "title": "Toggle Feature Blame",
        "category": "semi-git"
      },
      {
        "command": "sgt.openWorkbench",
        "title": "Open Composition Workbench",
        "category": "semi-git",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "sgt.openRenderPanel",
        "title": "Open Running App (render panel)",
        "category": "sgt"
      },
      {
        "command": "sgt.revealInWorkbench",
        "title": "Reveal Feature in Workbench",
        "category": "semi-git"
      },
      {
        "command": "sgt.previewRevert",
        "title": "Preview Revert (plug out)",
        "category": "semi-git",
        "icon": "$(diff)"
      },
      {
        "command": "sgt.revert",
        "title": "Revert (choose which dependents to keep)",
        "category": "semi-git"
      },
      {
        "command": "sgt.revertSymbol",
        "title": "Revert Symbol Under Cursor (choose dependents)",
        "category": "semi-git"
      },
      {
        "command": "sgt.restore",
        "title": "Restore (plug in)",
        "category": "semi-git"
      },
      {
        "command": "sgt.edit",
        "title": "Edit in place",
        "category": "semi-git"
      },
      {
        "command": "sgt.showPlanQuickPick",
        "title": "Show Plan Steps",
        "category": "semi-git"
      },
      {
        "command": "sgt.showPlanDiff",
        "title": "Show Plan Step Diff",
        "category": "semi-git"
      },
      {
        "command": "sgt.init",
        "title": "Initialize (sgt init)",
        "category": "semi-git"
      },
      {
        "command": "sgt.resolveFork",
        "title": "Resolve Fork",
        "category": "semi-git"
      },
      {
        "command": "sgt.resolveStalledPlan",
        "title": "Resolve Stalled Plan",
        "category": "semi-git"
      },
      {
        "command": "sgt.proposeLand",
        "title": "Land Proposal",
        "category": "semi-git (advanced)"
      },
      {
        "command": "sgt.proposePublish",
        "title": "Publish Proposal (GitHub PR)",
        "category": "semi-git (advanced)"
      },
      {
        "command": "sgt.viewProposal",
        "title": "View Proposal",
        "category": "semi-git (advanced)"
      },
      {
        "command": "sgt.jumpToLocation",
        "title": "Jump to Location",
        "category": "semi-git"
      },
      {
        "command": "sgt.switch",
        "title": "Switch Branch",
        "category": "semi-git"
      },
      {
        "command": "sgt.save",
        "title": "Save",
        "category": "semi-git"
      },
      {
        "command": "sgt.undo",
        "title": "Undo Last Operation",
        "category": "semi-git"
      },
      {
        "command": "sgt.sync",
        "title": "Sync",
        "category": "semi-git",
        "icon": "$(sync)"
      },
      {
        "command": "sgt.push",
        "title": "Push",
        "category": "semi-git",
        "icon": "$(repo-push)"
      },
      {
        "command": "sgt.land",
        "title": "Land Branch",
        "category": "semi-git"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "sgt.refresh",
          "when": "view == sgtNow",
          "group": "navigation"
        },
        {
          "command": "sgt.refresh",
          "when": "view == sgtFeatures",
          "group": "navigation"
        },
        {
          "command": "sgt.refresh",
          "when": "view == sgtChanges",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "sgt.revertSymbol",
          "when": "sgt.hasRoot && editorTextFocus",
          "group": "sgt@1"
        },
        {
          "command": "sgt.revealInWorkbench",
          "when": "sgt.hasRoot && editorTextFocus",
          "group": "sgt@2"
        }
      ],
      "view/item/context": [
        {
          "command": "sgt.previewRevert",
          "when": "view == sgtFeatures && viewItem == sgtFeature"
        },
        {
          "command": "sgt.revert",
          "when": "view == sgtFeatures && viewItem == sgtFeature"
        },
        {
          "command": "sgt.restore",
          "when": "view == sgtFeatures && viewItem == sgtFeature"
        },
        {
          "command": "sgt.edit",
          "when": "view == sgtFeatures && viewItem == sgtFeature"
        },
        {
          "command": "sgt.previewRevert",
          "when": "view == sgtFeatures && viewItem == sgtChapter",
          "group": "sgt@1"
        },
        {
          "command": "sgt.revert",
          "when": "view == sgtFeatures && viewItem == sgtChapter",
          "group": "sgt@1"
        },
        {
          "command": "sgt.restore",
          "when": "view == sgtFeatures && viewItem == sgtChapter",
          "group": "sgt@1"
        }
      ]
    },
    "walkthroughs": [
      {
        "id": "sgt.gettingStarted",
        "title": "Get started with semi-git",
        "description": "Set up sgt and see your codebase clustered by feature.",
        "steps": [
          {
            "id": "install",
            "title": "Install the sgt CLI",
            "description": "This extension shells out to the `sgt` CLI on your PATH.",
            "media": {
              "markdown": "walkthroughs/getting-started/install.md"
            },
            "completionEvents": [
              "onContext:sgt.hasRoot"
            ]
          },
          {
            "id": "init",
            "title": "Initialize this workspace",
            "description": "Read your git history into the op store under `.sgt/`.",
            "media": {
              "markdown": "walkthroughs/getting-started/init.md"
            },
            "completionEvents": [
              "onCommand:sgt.init"
            ]
          },
          {
            "id": "explore",
            "title": "Explore your feature tree",
            "description": "See your codebase clustered into features.",
            "media": {
              "markdown": "walkthroughs/getting-started/explore.md"
            },
            "completionEvents": [
              "onView:sgtFeatures"
            ]
          }
        ]
      }
    ]
  },
  "scripts": {
    "compile": "tsc --noEmit && node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "tsc --noEmit && node esbuild.js --production",
    "vscode:prepublish": "npm run package",
    "test": "node --test src/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.21.0",
    "typescript": "^5.4.0"
  }
}
