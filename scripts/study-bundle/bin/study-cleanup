#!/usr/bin/env bash
# Remove the projects and the session's keys from this machine.
#
# It refuses to run until everything recorded has been delivered, because the
# one irreversible mistake available at this point is deleting a session that
# was never uploaded.
set -euo pipefail

STUDY_HOME="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck disable=SC1091
[ -f "$STUDY_HOME/study.env" ] && . "$STUDY_HOME/study.env"
: "${STUDY_PY:=$STUDY_HOME/work/.venv/bin/python}"
export STUDY_HOME STUDY_CODE="${STUDY_CODE:-}"

echo "Making sure everything has reached us first."
if ! "$STUDY_HOME/bin/study-sync" --final; then
    echo
    echo "Not everything has arrived, so nothing has been deleted."
    echo "Tell your facilitator and leave this folder where it is."
    exit 1
fi

echo
echo "This will delete:"
echo "  $STUDY_HOME/work          the project"
echo "  $STUDY_HOME/toolenv       the tool it installed"
echo "  $STUDY_HOME/.claude-study the assistant profile and the session key"
echo "  $STUDY_HOME/.vscode-study the editor profile and its extension"
echo
echo "It keeps the log of what you did, which has already been delivered."
echo
printf "Type yes to go ahead: "
read -r answer
if [ "$answer" != "yes" ]; then
    echo "Nothing deleted."
    exit 0
fi

# The background pusher first, because it recreates the directory it writes
# into. Leave one running and the folder the last line invites you to delete
# comes back twenty seconds later. It stops on its own once this shell is gone
# (see telemetry/sync.py), but this is the moment we are telling somebody the
# folder is theirs to remove, so it should already be true.
pkill -f "$STUDY_HOME/telemetry/sync.py --daemon" 2>/dev/null || true

rm -rf "$STUDY_HOME/work" "$STUDY_HOME/toolenv" \
       "$STUDY_HOME/.claude-study" "$STUDY_HOME/.vscode-study"
rm -f "$STUDY_HOME/study.env"

echo
echo "Done. Your own assistant setup and everything outside this folder were never touched."
echo "You can delete the whole folder now if you like."
