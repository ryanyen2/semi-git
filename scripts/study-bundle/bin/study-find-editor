#!/usr/bin/env bash
# Which editor the session runs in, decided in one place for all three callers:
# setup, the launcher, and the check.
#
# Prints the path to the Visual Studio Code command line and exits 0. If there
# is no such editor on this machine it prints, on stdout too, one line saying
# what it found instead, and exits 1 -- so a caller reads the same variable
# either way and the participant is told which of the two problems they have.
#
# It has to be Visual Studio Code itself, and that is a different question from
# "is there a `code` command". Cursor installs its own: the binary inside
# Cursor.app is literally named `code`, so a machine with both runs whichever
# the PATH reached first. In pilot X08 that was Cursor, and two things followed
# from it. The visible one was the setup check: Pylance and the Python
# environments extension are licensed to Microsoft's own builds, Cursor ships a
# different marketplace, and neither would install -- while `ms-python.python`
# and `debugpy`, which are on both, did. The one that would have cost the
# session went unreported: Cursor is an AI editor. The protocol gives the task
# block no assistant in either condition, and that half would have been worked
# with completion and an agent panel one keystroke away.
#
# So: look where Visual Studio Code installs itself before looking at the PATH,
# and read product.json to say who a candidate actually is. `--version` cannot
# settle it -- it prints a number and not a name, and the number is the thing
# the forks change. Anything whose layout we cannot read is turned down rather
# than guessed at: a participant sent to their facilitator costs a message, and
# an unnoticed fork costs the half.
set -uo pipefail

WANTED="Visual Studio Code"

# The `code` on the PATH is nearly always a link into the app that owns it --
# that is how both editors install theirs -- so the name has to be read where
# the link lands, not where it sits.
resolve() {
    local target="$1" dir
    while [ -L "$target" ]; do
        dir="$(dirname "$target")"
        target="$(readlink "$target")"
        case "$target" in /*) ;; *) target="$dir/$target" ;; esac
    done
    printf '%s\n' "$target"
}

# product.json sits two levels above the CLI in the macOS app and three in the
# Linux packages.
name_of() {
    local base
    base="$(cd "$(dirname "$(resolve "$1")")/.." 2>/dev/null && pwd)" || return 1
    for meta in "$base/product.json" "$base/resources/app/product.json"; do
        [ -f "$meta" ] || continue
        sed -n 's/.*"nameLong"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$meta" | head -1
        return 0
    done
    return 1
}

impostor=""
for candidate in \
    "/Applications/Visual Studio Code.app/Contents/Resources/app/bin/code" \
    "$HOME/Applications/Visual Studio Code.app/Contents/Resources/app/bin/code" \
    "/usr/share/code/bin/code" \
    "/opt/visual-studio-code/bin/code" \
    "/snap/bin/code" \
    "$(command -v code 2>/dev/null || true)"; do
    [ -n "$candidate" ] && [ -x "$candidate" ] || continue
    found="$(name_of "$candidate" || true)"
    if [ "$found" = "$WANTED" ]; then
        echo "$candidate"
        exit 0
    fi
    # Remembered rather than reported here, because the next candidate may
    # still be the real thing and a machine with both is the common case.
    [ -n "$found" ] && [ -z "$impostor" ] && impostor="$found ($candidate)"
done

if [ -n "$impostor" ]; then
    echo "the 'code' command here is $impostor, not Visual Studio Code; install Visual Studio Code from https://code.visualstudio.com"
else
    echo "Visual Studio Code was not found; install it from https://code.visualstudio.com"
fi
exit 1
