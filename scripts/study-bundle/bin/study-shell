#!/usr/bin/env bash
# The session shell. Everything for the study runs in here.
#
# It exists so that three things are true at once and stay true for the whole
# session: the assistant runs from a profile inside this folder on a key we
# issued, the commands the participant types are recorded, and their own machine
# is left exactly as it was. Anything run outside this shell is untracked and,
# for the assistant, would fall back to their own account.
set -euo pipefail

STUDY_HOME="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck disable=SC1091
[ -f "$STUDY_HOME/study.env" ] && . "$STUDY_HOME/study.env"
: "${STUDY_PY:=$STUDY_HOME/work/.venv/bin/python}"

export STUDY_HOME STUDY_PY
export STUDY_CODE="${STUDY_CODE:-}"
export STUDY_SHIM_DIR="$STUDY_HOME/bin/shims"
export CLAUDE_CONFIG_DIR="$STUDY_HOME/.claude-study"
# Where a command was run. The editor's launcher says `editor`; anything that
# inherits this shell is a command somebody typed.
export STUDY_SURFACE=terminal

# Their key must not be picked up. The assistant authenticates through the
# apiKeyHelper in the isolated profile, so nothing here is billed to them.
#
# `OPENAI_*` belongs on this list for the same reason and was missing from it.
# The history tool resolves its credential with "a key exported in the shell
# always wins over .env" -- a deliberate rule, and the wrong one here: a
# participant who happens to export their own key would have had it used for
# every label and every search, billed to them, while the key we issued sat
# unused in `work/.env` and the setup page still showed green.
unset ANTHROPIC_API_KEY ANTHROPIC_AUTH_TOKEN ANTHROPIC_BASE_URL || true
unset OPENAI_API_KEY OPENAI_BASE_URL || true

export PATH="$STUDY_SHIM_DIR:$STUDY_HOME/bin:$STUDY_HOME/work/.venv/bin:$PATH"

if [ ! -x "$STUDY_PY" ]; then
    echo "The project environment is missing. Run install/setup.sh first." >&2
    exit 1
fi

# Without a key, Claude Code does not fail -- it offers to sign in, and the
# obliging thing to do is sign in with your own account. That bills the
# participant, runs a model the study did not choose, and looks exactly like a
# normal session afterwards. Say so before they reach that screen.
if [ ! -s "$STUDY_HOME/.claude-study/api-key" ]; then
    echo
    echo "  No assistant key was issued for this session."
    echo
    echo "  If you start the assistant it will ask you to sign in. Please do not:"
    echo "  it would use your own account, and we cannot use that session."
    echo "  Tell your facilitator, then run install/setup.sh again with your code."
    echo
fi

# A background pusher, so the facilitator is never more than twenty seconds
# behind. The trap below kills it, but only when this shell exits cleanly:
# close the terminal window and the trap never runs. The daemon stops itself in
# that case, which is what keeps a deleted study folder deleted -- see
# session_is_over() in telemetry/sync.py.
if [ -n "$STUDY_CODE" ]; then
    "$STUDY_HOME/bin/study-sync" --daemon >/dev/null 2>&1 &
    SYNC_PID=$!
    trap 'kill "$SYNC_PID" 2>/dev/null || true; "$STUDY_HOME/bin/study-sync" --quiet >/dev/null 2>&1 || true' EXIT
fi

RC="$(mktemp "${TMPDIR:-/tmp}/study-rc.XXXXXX")"
cat > "$RC" <<RCFILE
# Deliberately not your own shell config. Aliases and wrappers differ from
# person to person, and a session where one participant's \`git\` is really
# something else is a session we cannot compare with anyone's.
export PS1='study \W \$ '
export HISTFILE="$STUDY_HOME/telemetry/shell-history"
export HISTSIZE=10000
export EDITOR="\${EDITOR:-nano}"

study-work() { cd "$STUDY_HOME/work"; }

cd "$STUDY_HOME/work"

echo
echo "Session shell. The project is in \\\$(pwd)."
echo
echo "  claude            the assistant, on our key and our profile"
echo "  study-code        open the project in the editor"
echo "  study-work        back to the project folder"
echo "  study-doctor      re-run the setup checks"
echo "  study-sync        push what has been recorded so far"
echo
echo "  ./stage 0         the project as it was before the warm-up"
echo "  ./stage 1 .. 4    the starting state for one stage"
echo "  ./check 3 or 4    what the dashboard says now"
echo
echo "Leave this shell open for the whole half. Type exit when the half is done."
echo
RCFILE

trap 'rm -f "$RC"' RETURN 2>/dev/null || true
exec bash --noprofile --rcfile "$RC" -i
