#!/usr/bin/env bash
# Inside the session shell this is a function that changes directory. Run as a
# command it can only tell you where to go, since a child process cannot move
# its parent.
STUDY_HOME="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
if [ -d "$STUDY_HOME/practice" ]; then
    echo "cd $STUDY_HOME/practice"
    echo
    echo "That is the warm-up copy. Nothing you do to it counts."
else
    echo "No practice copy in this bundle." >&2
    exit 1
fi
