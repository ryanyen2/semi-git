#!/usr/bin/env bash
# ./stage 0|1|2|3|4 -- put the project where this stage starts.
#
# Stage 0 is the warm-up. It is the project as it stood before the assistant's
# changes, so somebody can poke at the real codebase for ten minutes without
# reading the work stage 1 is about to ask them to record.
#
# Every stage begins with this, and it undoes whatever the last stage left
# behind. That is deliberate (docs/study/protocol-v2.md §3): a stage that went
# badly must not make the next one harder, so everyone starts each stage from
# the same place.
#
# It resets to a state built before the session by
# `scripts/study/build_stages.sh`, so nothing here computes anything under a
# clock.
#
# NOTHING IN HERE MAY NAME ONE PROJECT.
#
# The same file ships in all four bundles. It used to import `bikecount` by
# name, quote bikecount's two averages, and print bikecount's commit subjects,
# so in the footfall arm stage 2 printed "?" for the number the whole stage is
# about and stage 3 printed three blank lines where the work to remove should
# have been. Every project-specific fact below is now read out of the project
# in front of it.
set -euo pipefail
cd "$(dirname "$0")"

stage="${1:-}"
case "$stage" in
    0|1|2|3|4) ;;
    *) echo "usage: ./stage 0|1|2|3|4" >&2; exit 2 ;;
esac

bold=$'\033[1m'; dim=$'\033[2m'; off=$'\033[0m'
py="$(command -v python3)"; [ -x .venv/bin/python ] && py=.venv/bin/python
have_sgt() { [ -d .sgt ] && command -v sgt >/dev/null 2>&1; }

# A dashboard server left over from an earlier stage (or an earlier session --
# closing the editor does not always take the process with it) still holds
# port 8000, and the next `python -m <pkg>.server` dies with "Address already
# in use". Every stage starts here, so this is the one place that can clean it
# up for everyone. Only python processes are touched -- the port is not ours to
# clear if something else on the participant's machine happens to hold it, and
# in that case the honest move is to say so rather than kill it.
for pid in $(lsof -ti tcp:8000 -sTCP:LISTEN 2>/dev/null || true); do
    if ps -p "$pid" -o comm= 2>/dev/null | grep -qi python; then
        echo "${dim}Stopping the dashboard server left running from before.${off}"
        kill "$pid" 2>/dev/null || true
        sleep 0.3
        kill -9 "$pid" 2>/dev/null || true
    else
        echo "${dim}Port 8000 is held by another program on this machine — the dashboard"
        echo "will not start until it is closed. Tell your facilitator.${off}"
    fi
done

# The python package this dashboard lives in -- `bikecount` or `footfall`. It is
# the one top-level directory holding a metrics module, and reading it here is
# what lets everything below run against either project.
pkg() {
    local m
    for m in */metrics.py; do
        [ -f "$m" ] && { dirname "$m"; return 0; }
    done
    return 1
}

# The 2018 average day, worked out two ways.
#
#   dashboard  what the by-year page shows right now, through the app's own
#              summary -- so it moves when the work under study comes out or
#              goes back in.
#   reported   the average over every day the sensors recorded, which is what
#              the published report was written against. A fact about the data
#              rather than about the code, so it reads the same in every state.
average_2018() {
    "$py" - "$(pkg)" "${1:-dashboard}" <<'PY' 2>/dev/null || echo "?"
import importlib, sys
sys.path.insert(0, ".")
pkg, which = sys.argv[1], sys.argv[2]
data = importlib.import_module(f"{pkg}.data")
metrics = importlib.import_module(f"{pkg}.metrics")
server = importlib.import_module(f"{pkg}.server")
readings = data.load_readings(server.DATA)
if which == "reported":
    days = [c for d, c in metrics.daily_totals(readings) if d.year == 2018]
    print(f"{round(sum(days) / len(days)):,}")
else:
    for row in metrics.yearly_summary(readings):
        if row[0] == 2018:
            print(f"{row[2]:,}")
            break
PY
}

# What this project calls the work stages 3 and 4 are about. bikecount named its
# own "Event-Day Handling" and footfall named its own "Event Day Handling", so
# the name is read out of the project's record rather than written here.
theme_label() {
    "$py" - <<'PY' 2>/dev/null || true
import json, pathlib
squash = lambda t: "".join(c for c in t.casefold() if c.isalnum())
p = pathlib.Path(".sgt/intent/themes.json")
if p.exists():
    for v in json.loads(p.read_text()).get("data", {}).values():
        if isinstance(v, dict) and "eventday" in squash(v.get("label", "")):
            print(v["label"])
            break
PY
}

# The commits that work spans, oldest first, for the arm that has no name for
# it. They are read back off the revert commits on `study/removed`, which
# `build_stages.sh` built from the other arm's record, so the two arms are
# describing the same work by construction.
removed_commits() {
    local subject
    # No --reverse: the reverts were made newest-original-first, so reading
    # them in log order (newest revert first) yields the originals oldest first,
    # which is the order the line above promises.
    git log --format='%s' study/removed ^study/full 2>/dev/null \
        | sed -n 's/^Revert "\(.*\)"$/\1/p' \
        | while IFS= read -r subject; do
            git log --format='%h  %s' --fixed-strings --grep="$subject" -1
        done
}

reset_to() {
    # `-B main`, not a plain checkout of the tag. Checking a tag out directly
    # detaches HEAD, and sgt keys its record by the branch it is on -- so every
    # command after a detached reset read and wrote a different record than the
    # one the project shipped with. It still reverted, but the restore in stage 4
    # then resolved against the wrong removal and put back two files out of five.
    git checkout -q -f -B main "$1" 2>/dev/null || { echo "this project is missing $1" >&2; exit 1; }
    git clean -qfd
    if have_sgt; then
        # Putting the files back is not the whole reset. sgt keeps a record of
        # every removal, and carrying stage 3's record into stage 4 makes the
        # restore there reverse the wrong removal and put back two files out of
        # five. So its state goes back to exactly what shipped, then re-derives
        # against wherever the history now stands.
        if [ -f .study/sgt-pristine.tar ]; then
            rm -rf .sgt && tar -xf .study/sgt-pristine.tar -C .
        fi
        sgt advanced resync >/dev/null 2>&1 || true
    fi
}

if [ "$stage" = 0 ]; then
    echo "${bold}Putting the project where the warm-up starts.${off}"
else
    echo "${bold}Putting the project where stage $stage starts.${off}"
fi

case "$stage" in
0)
    # The full history, the same state stage 1 starts from. Practice used to run
    # one piece of work short of it, because stage 1 then replayed that work into
    # the working copy as an unrecorded change and practising on the finished
    # version would have meant reading it early. Stage 1 asks what the project is
    # MADE of now, so there is nothing left to hide and no second state to
    # explain.
    reset_to study/full
    echo
    echo "This is the real project, with its whole history."
    echo "Everything you do to it here is undone when you run \`./stage 1\`, so"
    echo "nothing you try now can go wrong."
    ;;
1)
    reset_to study/full
    echo
    echo "The project is at its full history, with nothing of anyone else's left in it."
    echo
    echo "Start the dashboard in your other terminal if it is not running already:"
    echo "    ${bold}python3 -m $(pkg).server${off}   then open http://localhost:8000"
    ;;
2)
    reset_to study/full
    echo
    echo "The project is back to its full history, with nothing of yours left in it."
    echo
    echo "${bold}The disagreement this stage is about:${off}"
    echo "    the published report says the 2018 average day was  ${bold}$(average_2018 reported)${off}"
    echo "    the dashboard's by-year page now says               ${bold}$(average_2018 dashboard)${off}"
    ;;
3)
    reset_to study/full
    echo
    echo "The project is back to its full history, with nothing of yours left in it."
    echo
    echo "${bold}The work to take out is:${off}"
    if have_sgt; then
        label="$(theme_label)"
        echo "    ${label:-Event-Day Handling}"
        # One task's work, landed across several features. `sgt log` draws it as
        # a ◆ row under the lanes (cells in the touched lanes' own colours) and
        # the workbench marks it with a ◆ on the time axis -- the name above is
        # IN the picture, not in a separate listing to map back by hand.
        echo "${dim}    That is one piece of work that touched several features."
        echo "    \`sgt log\` draws it as a ◆ row under the lanes; in the workbench"
        echo "    it is a ◆ on the time axis — click it to see it. Revert and"
        echo "    restore both take that name exactly as it is written above.${off}"
    else
        echo "${dim}    three commits, oldest first:${off}"
        removed_commits | sed 's/^/    /'
        echo "${dim}    Each one is an ordinary commit. \`git show <hash>\` reads one.${off}"
    fi
    ;;
4)
    # The removed state has to be one the setup itself recorded making, not just
    # a tree that happens to look like it. Resetting straight onto a pre-built
    # removed commit and letting sgt re-derive its record from that history left
    # sgt with nothing marked as removed, so `sgt restore` answered "restores 0
    # edits" and this stage could not be completed at all.
    #
    # So each setup arrives here the way it would have arrived here in real
    # work: git checks out the branch holding the three revert commits, and sgt
    # performs the removal it records as a removal. Both end on the same
    # dashboard (build_stages.sh refuses to ship them otherwise); what differs
    # is what each one's history says happened, which is the thing under study.
    #
    # Both arms pass through `study/full` first, so the number the dashboard
    # showed BEFORE the removal can be written down. `./check 4` needs it to
    # say what the page should read again, and it is not recoverable from the
    # removed state.
    reset_to study/full
    average_2018 dashboard > .study/avg-before-removal
    if have_sgt; then
        label="$(theme_label)"
        sgt revert "${label:-Event-Day Handling}" --yes >/dev/null 2>&1 || {
            echo "could not set this stage up; tell your facilitator" >&2; exit 1; }
    else
        reset_to study/removed
    fi
    echo
    echo "The project is in the state where that work has already been taken out."
    echo "This is the same starting point for everyone, whether or not your own"
    echo "removal in the last stage worked."
    ;;
esac

echo
echo "${dim}Ready. The project is in this folder.${off}"
