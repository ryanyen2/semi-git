#!/usr/bin/env bash
# ./check 3|4 -- where you ended up.
#
# Prescribed so that whether somebody thinks to verify is not part of what the
# study measures, and worded identically in both setups so the two arms read the
# same words for the same outcome.
#
# It reports. It does not score, and it says so: a participant reading a green
# line as "you are correct" would stop looking, and the scoring happens
# afterwards from the repository (scripts/study/score_dashboard.py).
#
# Like `./stage`, nothing here may name one project: the same file ships in all
# four bundles. It imported `bikecount` by name and quoted bikecount's two
# averages, so in the footfall arm both stages reported "?" against a number
# that was never footfall's to begin with.
set -euo pipefail
cd "$(dirname "$0")"

stage="${1:-}"
case "$stage" in 3|4) ;; *) echo "usage: ./check 3|4" >&2; exit 2 ;; esac

bold=$'\033[1m'; dim=$'\033[2m'; green=$'\033[32m'; red=$'\033[31m'; off=$'\033[0m'
py="$(command -v python3)"; [ -x .venv/bin/python ] && py=.venv/bin/python

pkg() {
    local m
    for m in */metrics.py; do
        [ -f "$m" ] && { dirname "$m"; return 0; }
    done
    return 1
}

average_2018() {
    "$py" - "$(pkg)" "${1:-dashboard}" <<'PY' 2>/dev/null || echo "?"
import importlib, sys
sys.path.insert(0, ".")
pkg, which = sys.argv[1], sys.argv[2]
data = importlib.import_module(f"{pkg}.data")
metrics = importlib.import_module(f"{pkg}.metrics")
server = importlib.import_module(f"{pkg}.server")
readings = data.load_readings(server.DATA)
if which == "reported":
    days = [c for d, c in metrics.daily_totals(readings) if d.year == 2018]
    print(f"{round(sum(days) / len(days)):,}")
else:
    for row in metrics.yearly_summary(readings):
        if row[0] == 2018:
            print(f"{row[2]:,}")
            break
PY
}

# An unfinished merge/revert/cherry-pick, or a file still holding conflict
# markers, makes both checks below lie. The tree is halfway between two states:
# `check.py` can import cleanly while a doc still holds markers, and the average
# can read correctly out of a file the resolution has not reached yet -- which is
# exactly what the git arm saw in rehearsal, a full green over a revert that was
# still in progress with markers in README.md. Reported first, so it frames the
# two lines under it rather than being discovered afterwards.
#
# Only printed when there IS something half-finished. A permanent "no" line would
# be noise in the arm that cannot reach this state.
# Written as plain `if` blocks rather than `[ ... ] && var=yes` one-liners: this
# file runs under `set -e`, and a trailing `&&` list that evaluates false is
# exactly the shape whose exit-on-failure behaviour is worth not having to reason
# about. A check script that exits early prints nothing and looks like a pass.
gitdir="$(git rev-parse --git-dir 2>/dev/null || true)"
unfinished=""
conflicted=""
if [ -n "$gitdir" ]; then
    for marker in MERGE_HEAD CHERRY_PICK_HEAD REVERT_HEAD BISECT_LOG; do
        if [ -e "$gitdir/$marker" ]; then
            unfinished="yes"
        fi
    done
    if [ -d "$gitdir/rebase-merge" ] || [ -d "$gitdir/rebase-apply" ]; then
        unfinished="yes"
    fi
    conflicted="$(git diff --name-only --diff-filter=U 2>/dev/null || true)"
    if [ -n "$conflicted" ]; then
        unfinished="yes"
    fi
    # Markers that survived a resolution. `git add` on a file whose conflict was never actually
    # edited out marks it resolved, and `git revert --continue` then commits the markers: git is
    # satisfied, nothing is unmerged, no *_HEAD is left, and the file is a syntax error. Found
    # walking the git arm, by making the mistake. Only `<<<<<<<` and `>>>>>>>` are looked for --
    # `=======` is an ordinary underline in Markdown and would report every heading in the README.
    markers="$(git grep -lE '^(<<<<<<< |>>>>>>> )' -- . 2>/dev/null || true)"
    if [ -n "$markers" ]; then
        unfinished="yes"
        conflicted="$(printf '%s\n%s' "$conflicted" "$markers" | sed '/^$/d' | sort -u)"
    fi
fi
if [ -n "$unfinished" ]; then
    echo "${bold}Is anything half-finished?${off}"
    echo "  ${red}yes${off}   something you started is still in progress."
    if [ -n "$conflicted" ]; then
        echo "${dim}       these files still hold conflict markers:${off}"
        printf '%s\n' "$conflicted" | sed 's/^/           /'
    fi
    echo "${dim}       Finish it or undo it first. Until then the two checks below"
    echo "       describe a project that is halfway between two states.${off}"
    echo
fi

echo "${bold}Does the program still run?${off}"
if out=$("$py" check.py 2>&1); then
    echo "  ${green}yes${off}   $out"
else
    echo "  ${red}no${off}"
    printf '%s\n' "$out" | tail -5 | sed 's/^/       /'
fi

now="$(average_2018 dashboard)"

echo
# Stage 3 asks for the average over every day the sensors recorded, which is the
# number the published report was written against. Stage 4 puts back the average
# that leaves event days out, which is what the by-year page showed before the
# removal -- `./stage 4` wrote it down on the way through, because it cannot be
# worked out from the state stage 4 starts in.
if [ "$stage" = 3 ]; then
    echo "${bold}Do the averages count every day again?${off}"
    want="$(average_2018 reported)"; note="the number the published report quotes"
else
    echo "${bold}Is the dashboard back to what it showed before the removal?${off}"
    want="$(cat .study/avg-before-removal 2>/dev/null || echo '?')"
    note="what the by-year page showed before"
fi
echo "    the 2018 average day should be  ${bold}${want}${off}   ${dim}(${note})${off}"
echo "    it currently reads              ${bold}${now}${off}"
if [ "$now" = "$want" ]; then
    echo "    ${green}those match${off}"
else
    echo "    ${red}those do not match yet${off}"
fi

echo
echo "${dim}This tells you where you are. It does not mark you, and a red line here"
echo "is information rather than a verdict.${off}"
